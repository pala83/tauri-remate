{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Libro de Remates",
  "mainBinaryName": "libro-de-remates",
  "version": "1.0.0",
  "identifier": "com.palazzo.remates",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Libro de Remates",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/imagenes/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "publisher": "Ulises Palazzo",
    "copyright": "© 2026 Ulises Palazzo",
    "category": "Business",
    "shortDescription": "Libro de remates: lotes, ventas, clientes y liquidaciones.",
    "longDescription": "Lleva un remate de punta a punta: la carga de lotes, la venta lote por lote, los clientes y sus liquidaciones, cuotas y pagos. Los datos quedan en una base local del equipo.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
