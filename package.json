{
  "name": "my-qwik-empty-starter",
  "version": "1.0.0",
  "description": "Blank project with routing included",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "db.generate": "drizzle-kit generate",
    "db.studio": "drizzle-kit studio",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.3",
    "@builder.io/qwik-city": "^1.20.3",
    "@eslint/js": "^9",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@qwik-ui/headless": "^0.7.7",
    "@qwik-ui/styled": "^0.4.1",
    "@qwik-ui/utils": "^0.3.3",
    "@qwikest/icons": "^0.0.13",
    "@tailwindcss/vite": "^4.1.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@types/bun": "^1.4.4",
    "@types/node": "20.19.0",
    "class-variance-authority": "0.7.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.20.3",
    "globals": "16.4.0",
    "nx": "^24.0.3",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "qwik-ui": "^0.4.3",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "1.3.4",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "*",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "nx": {}
}
